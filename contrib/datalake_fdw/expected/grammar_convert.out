CREATE READABLE EXTERNAL TABLE orc_read (a int, b int)
LOCATION('oss://obs.cn-north-4.myhuaweicloud.com/ossext-ci-test/ext_orc/moreSmallFile/ oss_type=QS access_key_id=KGCPPHVCHRMZMFEAWLLC secret_access_key=0SJIWiIATh6jOlmAKr8DGq6hOAGBI1BnsnvgJmTs') FORMAT 'orc';
NOTICE:  external table syntax will be deprecated in the future HashData version, please use foreign table instead.
\d orc_read
                 Foreign table "public.orc_read"
 Column |  Type   | Collation | Nullable | Default | FDW options 
--------+---------+-----------+----------+---------+-------------
 a      | integer |           |          |         | 
 b      | integer |           |          |         | 
Server: oss_server
FDW options: (filepath '/ossext-ci-test/ext_orc/moreSmallFile/', format 'orc', encoding 'UTF-8')

